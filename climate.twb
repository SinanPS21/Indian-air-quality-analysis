      <aliases enabled='yes' />
      <column datatype='real' name='[AQI]' role='measure' type='quantitative' />
      <column caption='AQI Category' datatype='string' name='[AQI_Category]' role='dimension' type='nominal' />
      <column datatype='real' name='[Benzene (ug/m3)]' role='measure' type='quantitative' />
      <column datatype='real' name='[CO (mg/m3)]' role='measure' type='quantitative' />
      <column caption='Avg PM2.5' datatype='real' name='[Calculation_1229533675081728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([PM2.5 (ug/m3)])' />
      </column>
      <column caption='WHO Exceed %' datatype='real' name='[Calculation_1229533675200513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Exceeds_WHO_Limit]) / COUNT([Exceeds_WHO_Limit]) * 100' />
      </column>
      <column caption='City PM2.5 LOD' datatype='real' name='[Calculation_1229533675286530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [City] : AVG([PM2.5 (ug/m3)]) }' />
      </column>
      <column caption='Top Polluted City' datatype='string' name='[Calculation_1229533675376643]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1229533675286530] = { MAX([Calculation_1229533675286530]) }&#13;&#10;THEN [City]&#13;&#10;END' />
      </column>
      <column caption=' State PM2.5 LOD' datatype='real' name='[Calculation_1229533675474948]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : AVG([PM2.5 (ug/m3)]) }' />
      </column>
      <column caption='Pollution Category' datatype='string' name='[Calculation_1229533675573253]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([PM2.5 (ug/m3)]) &gt; 120 THEN &quot;Severe&quot;&#13;&#10;ELSEIF AVG([PM2.5 (ug/m3)]) &gt; 60 THEN &quot;High&quot;&#13;&#10;ELSEIF AVG([PM2.5 (ug/m3)]) &gt; 30 THEN &quot;Moderate&quot;&#13;&#10;ELSE &quot;Low&quot;&#13;&#10;END' />
      </column>
      <column caption='Top Polluted State' datatype='string' name='[Calculation_1229533675933702]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1229533675474948]={MAX([Calculation_1229533675474948])} THEN [State] END' />
      </column>
